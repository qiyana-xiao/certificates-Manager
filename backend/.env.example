# 将本文件另存为 backend\.env 并填写真实值（.env 不会提交到 Git）
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=doc_keeper

# JWT 密钥：至少 32 个字符的随机乱码
JWT_SECRET=

# 敏感字段加密密钥：Base64 编码的 32 字节；留空则不启用密文加密
# 生成：powershell 执行
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
ENC_KEY=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173